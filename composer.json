{
    "name": "juanchosl/tokenizer",
    "description": "A small collection of encoder/decoder Token for authentication",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/JuanchoSL/Tokenizer",
    "keywords": [
        "token",
        "basic token",
        "digest token",
        "bearer token",
        "jwt token"
    ],
    "authors": [
        {
            "name": "Juan Sánchez Lecegui",
            "email": "Juan.Sanchez@tecnicosweb.com",
            "homepage": "https://www.linkedin.com/in/juansanchezlecegui/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-hash": "*",
        "juanchosl/datamanipulation": "1.0.*",
        "juanchosl/exceptions": "1.0.*"
    },
    "require-dev": {
        "phpstan/phpstan": "1.10.*",
        "phpunit/phpunit": "9.6.*"
    },
    "autoload": {
        "psr-4": {
            "JuanchoSL\\Tokenizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JuanchoSL\\Tokenizer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "tests": "vendor/bin/phpunit --configuration phpunit.xml tests",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon --xdebug"
    }
}